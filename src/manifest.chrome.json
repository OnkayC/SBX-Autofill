{
  "manifest_version": 3,
  "name": "SBX Autofill",
  "version": "1.2.10",
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": {
    "128": "assets/icons/app-icon-blue-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/app-icon-blue-19.png",
        "assets/icons/app-icon-grey-38.png",
        "assets/icons/app-icon-grey-19.png",
        "assets/icons/app-icon-blue-38.png",
        "assets/icons/app-icon-circle.png",
        "_favicon/*",
        "iframe.html"
      ],
      "matches": ["<all_urls>"],
      "extension_ids": ["*"]
    }
  ],
  "commands": {
    "autofill-first": {
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      },
      "description": "AutoFill"
    },
    "open-inline-menu": {
      "suggested_key": {
        "default": "Ctrl+Shift+O"
      },
      "description": "Show Inline Menu"
    }
  },
  "action": {
    "default_title": "SBX Autofill",
    "default_popup": "popup.html",
    "default_icon": {
      "19": "assets/icons/app-icon-blue-19.png",
      "38": "assets/icons/app-icon-blue-38.png"
    }
  },
  "description": "Autofill for Strongbox on macOS. Not affiliated with or endorsed by Phoebe Code Limited or Strongbox.",
  "short_name": "SBX Autofill",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "webNavigation",
    "storage",
    "favicon"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "author": "Onkay",
  "minimum_chrome_version": "88",
  "background": {
    "service_worker": "js/background.bundle.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "all_frames": true,
      "match_about_blank": true,
      "matches": ["http://*/*", "https://*/*"],
      "js": ["js/content.bundle.js"],
      "css": ["content.css"]
    }
  ],
  "key": ""
}
